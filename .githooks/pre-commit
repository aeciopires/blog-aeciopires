#!/usr/bin/env bash
# pre-commit versionado (PLAN.md 6.8). Ativar uma vez: make install-hooks
# 1) Em todo commit: bloqueia segredos/tokens/chaves privadas (gitleaks), arquivos sensíveis
#    e o e-mail do autor no conteúdo adicionado.
# 2) Só se houver .md alterado: check-tags e lint-md nesses arquivos.
# 3) Conteúdo, i18n/ ou menus alterados: versão em inglês completa e em dia (scripts/i18n.mjs check).
# 4) Conteúdo alterado com correções da IA ainda não conferidas em reports/correcoes-conteudo-*.md: bloqueia.
#    pt-BR mudou e a tradução não acompanhou? O commit para: traduza (skill traduzir-conteudo) e carimbe.
# 0) Antes de tudo: atualiza data/github.json (repositórios públicos no GitHub, home) e o inclui
#    no commit se o número mudou. Sem rede, segue sem mudar nada. Pular: GITHUB_REPOS_SKIP=1
# Falso positivo: ajuste .gitleaks.toml (exceção bem delimitada) ou marque a linha com
# "gitleaks:allow". "git commit --no-verify" só em último caso (a CI roda make check-secrets).
set -euo pipefail
RUN=""
command -v node >/dev/null 2>&1 || RUN="mise exec --"
GITLEAKS="gitleaks"
command -v gitleaks >/dev/null 2>&1 || GITLEAKS="mise exec -- gitleaks"

bloquear() {
  echo "pre-commit: BLOQUEADO — $1" >&2
  echo "Remova do commit (git restore --staged <arquivo>) e guarde segredos só em GitHub Secrets." >&2
  exit 1
}

# --- 0) Repositórios públicos no GitHub (cartão da home) ---
# Fica antes do gitleaks para o arquivo atualizado também ser verificado.
if [ "${GITHUB_REPOS_SKIP:-}" != "1" ]; then
  $RUN node scripts/github-repos.mjs || true
  # Só se o script mudou o arquivo (diferente do stage) ou se ele ainda não está no Git.
  if ! git diff --quiet -- data/github.json || [ -n "$(git ls-files --others --exclude-standard -- data/github.json)" ]; then
    git add data/github.json
    echo "pre-commit: data/github.json atualizado e incluído no commit."
  fi
fi

# --- 1a) Segredos, tokens e chaves privadas nas mudanças staged ---
if ! $GITLEAKS git --pre-commit --staged --redact --no-banner --log-level warn .; then
  bloquear "o gitleaks encontrou possível segredo/token/chave (valor ocultado acima)."
fi

# --- 1b) Arquivos que nunca devem ser versionados ---
sensiveis="$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -Ei '(^|/)\.env(\.[^/]*)?$|\.(pem|key|p12|pfx|jks|keystore|kdbx)$|(^|/)id_(rsa|dsa|ecdsa|ed25519)$|(^|/)credentials(\.json)?$|(^|/)\.npmrc$|(^|/)\.netrc$|\.claude/settings\.local\.json$' \
  | grep -Ev '(^|/)\.env\.example$' || true)"
if [ -n "$sensiveis" ]; then
  bloquear "arquivo sensível no commit:
$sensiveis"
fi

# --- 1c) E-mail do autor no conteúdo adicionado (CLAUDE.md: nunca publicar o e-mail) ---
# Lidos da configuração local do Git, para o e-mail não ficar escrito neste arquivo:
#   user.email e, opcionalmente, outros: git config --add hooks.emailbloqueado outro@exemplo.com
emails="$( { git config user.email || true; git config --get-all hooks.emailbloqueado || true; } | sort -u)"
if [ -n "$emails" ]; then
  adicionadas="$(git diff --cached -U0 --diff-filter=ACMR --no-color -- . ':(exclude)static/wp-content/**' | grep -E '^\+[^+]' || true)"
  while IFS= read -r email; do
    [ -n "$email" ] || continue
    case "$email" in *users.noreply.github.com) continue ;; esac
    if printf '%s\n' "$adicionadas" | grep -qiF -- "$email"; then
      bloquear "o e-mail do autor ($email) aparece nas linhas adicionadas. Use o formulário de contato (Jotform)."
    fi
  done <<EOF
$emails
EOF
fi

# --- 3) Versão em inglês (antes do lint, que encerra o hook) ---
i18n="$(git diff --cached --name-only --diff-filter=ACMRD -- 'content/*.md' 'i18n/*' 'config/_default/menus.*' || true)"
if [ -n "$i18n" ]; then
  # shellcheck disable=SC2086
  if ! $RUN node scripts/i18n.mjs check $i18n; then
    echo "pre-commit: BLOQUEADO — versão em inglês ausente, desatualizada ou com comandos/links diferentes do pt-BR (acima)." >&2
    echo "Veja: make i18n-status · make i18n-diff SLUG=… · skill traduzir-conteudo · make i18n-ok SLUG=…" >&2
    exit 1
  fi
fi

# --- 4) Correções feitas pela IA no conteúdo: o autor confere antes do commit ---
conteudo_alterado="$(git diff --cached --name-only --diff-filter=ACMR -- 'content/*.md' || true)"
if [ -n "$conteudo_alterado" ]; then
  # shellcheck disable=SC2086
  if ! $RUN node scripts/i18n.mjs correcoes $conteudo_alterado; then
    echo "pre-commit: BLOQUEADO — há correções da IA não conferidas nesses conteúdos (acima)." >&2
    exit 1
  fi
fi

# --- 2) Markdown alterado: tags e lint ---
arquivos="$(git diff --cached --name-only --diff-filter=ACM -- '*.md' | grep -v '^themes/' || true)"
[ -n "$arquivos" ] || exit 0
conteudo="$(printf '%s\n' "$arquivos" | grep '^content/' || true)"
if [ -n "$conteudo" ]; then
  # shellcheck disable=SC2086
  $RUN node scripts/tags.mjs check $conteudo
fi
# shellcheck disable=SC2086
$RUN markdownlint-cli2 $arquivos
